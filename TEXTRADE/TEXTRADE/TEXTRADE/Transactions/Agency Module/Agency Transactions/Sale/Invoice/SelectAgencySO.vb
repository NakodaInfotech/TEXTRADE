            Dim objclspreq As New ClsCommon()
            Dim DT As New DataTable
            WHERE = WHERE & " and (CASE WHEN AGENCYSALEORDER.ASO_ORDERON = 'PCS' THEN (AGENCYSALEORDER_DESC.ASO_MTRS - AGENCYSALEORDER_DESC.ASO_RECDQTY) ELSE (AGENCYSALEORDER_DESC.ASO_MTRS - AGENCYSALEORDER_DESC.ASO_RECDMTRS) END) > 0 AND AGENCYSALEORDER_DESC.ASO_CLOSED=0 "
