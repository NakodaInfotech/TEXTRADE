INGAGENCYSALEORDER_DESC.OPASO_GRIDREMARKS, '') AS GRIDDESC, OPENINGAGENCYSALEORDER_DESC.OPASO_QTY AS PERQTY, GROUPOFCOMPANIESMASTER.GOC_NAME AS  GOC FROM OPENINGAGENCYSALEORDER INNER JOIN LEDGERS ON OPENINGAGENCYSALEORDER.OPASO_ledgerid = LEDGERS.Acc_id INNER JOIN OPENINGAGENCYSALEORDER_DESC ON OPENINGAGENCYSALEORDER.OPASO_no = OPENINGAGENCYSALEORDER_DESC.OPASO_NO AND OPENINGAGENCYSALEORDER.OPASO_YEARID = OPENINGAGENCYSALEORDER_DESC.OPASO_YEARID LEFT OUTER JOIN PACKINGTYPEMASTER ON OPENINGAGENCYSALEORDER.OPASO_PACKINGTYPEID = PACKINGTYPEMASTER.PACKINGTYPE_ID LEFT OUTER JOIN LEDGERS AS PACKINGLEDGERS ON OPENINGAGENCYSALEORDER.OPASO_PACKINGID = PACKINGLEDGERS.Acc_id LEFT OUTER JOIN ITEMMASTER ON OPENINGAGENCYSALEORDER_DESC.OPASO_ITEMID = ITEMMASTER.item_id LEFT OUTER JOIN LEDGERS AS AGENTLEDGER ON OPENINGAGENCYSALEORDER.OPASO_Agentid = AGENTLEDGER.Acc_id LEFT OUTER JOIN ADDRESSMASTER ON OPENINGAGENCYSALEORDER.OPASO_HASTEID = ADDRESSMASTER.ADDRESS_ID LEFT OUTER JOIN DESIGNMASTER ON OPENINGAGENCYSALEORDER_DESC.OPASO_DESIGNID = DESIGN_ID LEFT OUTER JOIN COLORMASTER ON OPENINGAGENCYSALEORDER_DESC.OPASO_COLORID = COLOR_ID LEFT OUTER JOIN LEDGERS AS TRANSLEDGERS ON OPENINGAGENCYSALEORDER.OPASO_TRANSID = TRANSLEDGERS.ACC_ID LEFT OUTER JOIN CITYMASTER ON OPENINGAGENCYSALEORDER.OPASO_CITYID = CITYMASTER.CITY_ID LEFT OUTER JOIN GROUPOFCOMPANIESMASTER ON LEDGERS.ACC_GOCID = GROUPOFCOMPANIESMASTER.GOC_ID WHERE OPENINGAGENCYSALEORDER.OPASO_VERIFIED=1 AND OPENINGAGENCYSALEORDER.OPASO_YEARID = " & YearId & OPWHERE & "  UNION ALL SELECT ALLPURCHASEORDER.PO_no AS SONO, ALLPURCHASEORDER.PO_date AS DATE, LEDGERS.Acc_cmpname AS NAME, ISNULL(AGENTLEDGER.Acc_cmpname, '') AS AGENTNAME, ALLPURCHASEORDER.PO_REFNO AS [PONO], ISNULL(ITEMMASTER.item_name,'') AS [ITEMNAME], (CASE WHEN ALLPURCHASEORDER.PO_ORDERON = 'PCS' THEN (ALLPURCHASEORDER_DESC.PO_MTRS - ALLPURCHASEORDER_DESC.PO_RECDQTY) ELSE (ALLPURCHASEORDER_DESC.PO_QTY - ALLPURCHASEORDER_DESC.PO_RECDQTY) END) AS [QTY],  (CASE WHEN ALLPURCHASEORDER.PO_ORDERON = 'PCS' THEN (ALLPURCHASEORDER_DESC.PO_MTRS - ALLPURCHASEORDER_DESC.PO_RECDQTY) ELSE (ALLPURCHASEORDER_DESC.PO_MTRS - ALLPURCHASEORDER_DESC.PO_RECDMTRS) END) AS [MTRS], ALLPURCHASEORDER.PO_remarks AS REMARKS, ALLPURCHASEORDER_DESC.PO_GRIDSRNO AS GRIDSRNO, '' AS DELIVERYAT, ISNULL(DESIGN_NO,'') AS DESIGNNO, ISNULL(COLOR_NAME,'') AS COLOR, ISNULL(TRANSLEDGERS.ACC_CMPNAME,'') AS TRANSNAME, ISNULL(ALLPURCHASEORDER.PO_REFNO,'') AS REFNO, ALLPURCHASEORDER_DESC.PO_RATE AS RATE, '' AS CITYNAME, ALLPURCHASEORDER.TYPE, '' AS GRIDPARTYPONO, '' AS PACKINGTYPE, ISNULL(ALLPURCHASEORDER_DESC.PO_GRIDREMARKS, '') AS GRIDDESC, ALLPURCHASEORDER_DESC.PO_QTY AS PERQTY, ISNULL(GROUPOFCOMPANIESMASTER.GOC_NAME, '') AS GOC FROM ALLPURCHASEORDER INNER JOIN LEDGERS ON ALLPURCHASEORDER.PO_ledgerid = LEDGERS.Acc_id INNER JOIN ALLPURCHASEORDER_DESC ON ALLPURCHASEORDER.PO_no = ALLPURCHASEORDER_DESC.PO_NO AND ALLPURCHASEORDER.PO_YEARID = ALLPURCHASEORDER_DESC.PO_YEARID LEFT OUTER JOIN ITEMMASTER ON ALLPURCHASEORDER_DESC.PO_ITEMID = ITEMMASTER.item_id LEFT OUTER JOIN LEDGERS AS AGENTLEDGER ON ALLPURCHASEORDER.PO_BROKERID = AGENTLEDGER.Acc_id LEFT OUTER JOIN DESIGNMASTER ON ALLPURCHASEORDER_DESC.PO_DESIGNID = DESIGN_ID LEFT OUTER JOIN COLORMASTER ON ALLPURCHASEORDER_DESC.PO_COLORID = COLOR_ID LEFT OUTER JOIN LEDGERS AS TRANSLEDGERS ON ALLPURCHASEORDER.PO_TRANSID = TRANSLEDGERS.ACC_ID LEFT OUTER JOIN GROUPOFCOMPANIESMASTER ON LEDGERS.ACC_GOCID = GROUPOFCOMPANIESMASTER.GOC_ID WHERE  ALLPURCHASEORDER.PO_VERIFIED=1 AND  ALLPURCHASEORDER.PO_YEARID = " & YearId & " AND (CASE WHEN '" & GOCNAME & "' = '' THEN ISNULL(LEDGERS.ACC_CMPNAME,'') ELSE ISNULL(GROUPOFCOMPANIESMASTER.GOC_NAME,'') END) = (CASE WHEN '" & GOCNAME & "' = '' THEN '" & SELLERNAME & "' ELSE '" & GOCNAME & "' END) and '" & BUYERNAME & "' = 'ABHEE FABRICS LLP [ BUYER ]' And (CASE WHEN ALLPURCHASEORDER.PO_ORDERON = 'PCS' THEN (ALLPURCHASEORDER_DESC.PO_MTRS - ALLPURCHASEORDER_DESC.PO_RECDQTY) ELSE (ALLPURCHASEORDER_DESC.PO_MTRS - ALLPURCHASEORDER_DESC.PO_RECDMTRS) END) > 0 AND ALLPURCHASEORDER_DESC.PO_CLOSED=0  UNION ALL SELECT ALLSALEORDER.SO_no AS SONO, ALLSALEORDER.SO_date AS DATE, LEDGERS.Acc_cmpname AS NAME, ISNULL(AGENTLEDGER.Acc_cmpname, '') AS AGENTNAME, ALLSALEORDER.SO_pono AS [PONO], ISNULL(ITEMMASTER.item_name,'') AS [ITEMNAME], (CASE WHEN ALLSALEORDER.SO_ORDERON = 'PCS' THEN (ALLSALEORDER_DESC.SO_MTRS - ALLSALEORDER_DESC.SO_RECDQTY) ELSE (ALLSALEORDER_DESC.SO_QTY - ALLSALEORDER_DESC.SO_RECDQTY) END) AS [QTY],  (CASE WHEN ALLSALEORDER.SO_ORDERON = 'PCS' THEN (ALLSALEORDER_DESC.SO_MTRS - ALLSALEORDER_DESC.SO_RECDQTY) ELSE (ALLSALEORDER_DESC.SO_MTRS - ALLSALEORDER_DESC.SO_RECDMTRS) END) AS [MTRS], ALLSALEORDER.SO_remarks AS REMARKS, ALLSALEORDER_DESC.SO_GRIDSRNO AS GRIDSRNO, ISNULL(PACKINGLEDGERS.Acc_cmpname, '') AS DELIVERYAT, ISNULL(DESIGN_NO,'') AS DESIGNNO, ISNULL(COLOR_NAME,'') AS COLOR, ISNULL(TRANSLEDGERS.ACC_CMPNAME,'') AS TRANSNAME, ISNULL(ALLSALEORDER.SO_REFNO,'') AS REFNO, ALLSALEORDER_DESC.SO_RATE AS RATE, ISNULL(CITYMASTER.CITY_NAME,'') AS CITYNAME, ALLSALEORDER.TYPE, '' AS GRIDPARTYPONO, ISNULL(PACKINGTYPEMASTER.PACKINGTYPE_NAME,'') AS PACKINGTYPE, ISNULL(ALLSALEORDER_DESC.SO_GRIDREMARKS, '') AS GRIDDESC, ALLSALEORDER_DESC.SO_QTY AS PERQTY, ISNULL(GROUPOFCOMPANIESMASTER.GOC_NAME, '') AS GOC   FROM ALLSALEORDER INNER JOIN LEDGERS ON ALLSALEORDER.SO_ledgerid = LEDGERS.Acc_id INNER JOIN ALLSALEORDER_DESC ON ALLSALEORDER.SO_no = ALLSALEORDER_DESC.SO_NO AND ALLSALEORDER.SO_YEARID = ALLSALEORDER_DESC.SO_YEARID LEFT OUTER JOIN PACKINGTYPEMASTER ON ALLSALEORDER.SO_PACKINGTYPEID = PACKINGTYPEMASTER.PACKINGTYPE_ID LEFT OUTER JOIN LEDGERS AS PACKINGLEDGERS ON ALLSALEORDER.SO_PACKINGID = PACKINGLEDGERS.Acc_id LEFT OUTER JOIN ITEMMASTER ON ALLSALEORDER_DESC.SO_ITEMID = ITEMMASTER.item_id LEFT OUTER JOIN LEDGERS AS AGENTLEDGER ON ALLSALEORDER.SO_Agentid = AGENTLEDGER.Acc_id LEFT OUTER JOIN ADDRESSMASTER ON ALLSALEORDER.SO_HASTEID = ADDRESSMASTER.ADDRESS_ID LEFT OUTER JOIN DESIGNMASTER ON ALLSALEORDER_DESC.SO_DESIGNID = DESIGN_ID LEFT OUTER JOIN COLORMASTER ON ALLSALEORDER_DESC.SO_COLORID = COLOR_ID LEFT OUTER JOIN LEDGERS AS TRANSLEDGERS ON ALLSALEORDER.SO_TRANSID = TRANSLEDGERS.ACC_ID LEFT OUTER JOIN CITYMASTER ON ALLSALEORDER.SO_CITYID = CITYMASTER.CITY_ID LEFT OUTER JOIN GROUPOFCOMPANIESMASTER ON LEDGERS.ACC_GOCID = GROUPOFCOMPANIESMASTER.GOC_ID WHERE  ALLSALEORDER.SO_YEARID = " & YearId & " AND (CASE WHEN '" & GOCNAME & "' = '' THEN ISNULL(LEDGERS.ACC_CMPNAME,'') ELSE ISNULL(GROUPOFCOMPANIESMASTER.GOC_NAME,'') END) = (CASE WHEN '" & GOCNAME & "' = '' THEN '" & BUYERNAME & "' ELSE '" & GOCNAME & "' END) AND '" & SELLERNAME & "' = 'ABHEE FABRICS LLP [ SELLER ]' and (CASE WHEN ALLSALEORDER.SO_ORDERON = 'PCS' THEN (ALLSALEORDER_DESC.SO_MTRS - ALLSALEORDER_DESC.SO_RECDQTY) ELSE (ALLSALEORDER_DESC.SO_MTRS - ALLSALEORDER_DESC.SO_RECDMTRS) END) > 0 AND ALLSALEORDER_DESC.SO_CLOSED=0 ) AS T", " ORDER BY T.DATE, T.SONO, T.GRIDSRNO")

