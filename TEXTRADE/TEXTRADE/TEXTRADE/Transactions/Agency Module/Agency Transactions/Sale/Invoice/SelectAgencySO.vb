DGERS ON ALLSALEORDER.SO_TRANSID = TRANSLEDGERS.ACC_ID LEFT OUTER JOIN CITYMASTER ON ALLSALEORDER.SO_CITYID = CITYMASTER.CITY_ID LEFT OUTER JOIN GROUPOFCOMPANIESMASTER ON LEDGERS.ACC_GOCID = GROUPOFCOMPANIESMASTER.GOC_ID WHERE  ALLSALEORDER.SO_YEARID = " & YearId & " AND ISNULL(LEDGERS.ACC_CMPNAME,'') = '" & BUYERNAME & "' AND '" & SELLERNAME & "' = 'ABHEE FABRICS LLP [ SELLER ]' and (CASE WHEN ALLSALEORDER.SO_ORDERON = 'PCS' THEN (ALLSALEORDER_DESC.SO_MTRS - ALLSALEORDER_DESC.SO_RECDQTY) ELSE (ALLSALEORDER_DESC.SO_MTRS - ALLSALEORDER_DESC.SO_RECDMTRS) END) > 0 AND ALLSALEORDER_DESC.SO_CLOSED=0 ) AS T", " ORDER BY T.DATE, T.SONO, T.GRIDSRNO")
