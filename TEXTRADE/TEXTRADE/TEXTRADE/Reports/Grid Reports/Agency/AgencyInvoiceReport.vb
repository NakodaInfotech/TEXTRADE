    Private Sub cmdshow_Click(sender As Object, e As EventArgs) Handles cmdshow.Click
        Try
            If chkdate.Checked = True Then
                fillgrid(" AND (AGENCYINVOICEMASTER.AINVOICE_YEARID = " & YearId & ") AND (AGENCYINVOICEMASTER.AINVOICE_DATE >= '" & Format(dtfrom.Value, "yyyy-MM-dd") & "' AND AGENCYINVOICEMASTER.AINVOICE_DATE <= '" & Format(dtto.Value, "yyyy-MM-dd") & "') ")
            Else
                fillgrid(" AND (AGENCYINVOICEMASTER.AINVOICE_YEARID = " & YearId & ") ")
            End If
        Catch ex As Exception
            Throw ex
        End Try
    End Sub

    Private Sub gridbill_CustomUnboundColumnData(sender As Object, e As DevExpress.XtraGrid.Views.Base.CustomColumnDataEventArgs) Handles gridbill.CustomUnboundColumnData
        If e.Column.FieldName = "SRNO" Then
            ' Assign the row index + 1 as the serial number
            If e.IsGetData Then
                e.Value = e.ListSourceRowIndex + 1 ' ListSourceRowIndex gives the current row index
            End If
        End If
    End Sub
