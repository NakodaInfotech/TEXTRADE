    Private Sub ToolStripButton2_Click(sender As Object, e As EventArgs) Handles ToolStripButton2.Click
        Try
            Dim PATH As String = Application.StartupPath & "\Invoice Details.XLS"
            Dim opti As New DevExpress.XtraPrinting.XlsExportOptions
            opti.ShowGridLines = True
            opti.SheetName = "Invoice Details"
            gridbill.ExportToXls(PATH, opti)
            EXCELCMPHEADER(PATH, "Invoice Details", gridbill.VisibleColumns.Count + gridbill.GroupCount)
        Catch ex As Exception
            MsgBox("Invoice Details Excel File is Open, Please Close the File first then try to Export", MsgBoxStyle.Critical)
        End Try
    End Sub

    Private Sub TOOLWHATSAPP_Click(sender As Object, e As EventArgs) Handles TOOLWHATSAPP.Click
        Try
            ExportGridToPdf()

        Catch ex As Exception
            Throw ex
        End Try


    End Sub
    Private Sub ExportGridToPdf()
        Try
            Dim filePath As String = Application.StartupPath & "\AgencyInvoiceReport.pdf"
            Dim gridControlObj As DevExpress.XtraGrid.GridControl = gridbill.GridControl

            ' Adjust column widths as before
            Dim pageWidth As Integer = 1122 - 80
            Dim colCount As Integer = gridbill.Columns.Count
            Dim colWidth As Integer = pageWidth \ colCount
            For Each col As DevExpress.XtraGrid.Columns.GridColumn In gridbill.Columns
                col.Width = colWidth
            Next
            gridbill.Columns("DATE").Width = 80
            gridbill.Columns("BUYERNAME").Width = 180
            gridbill.Columns("SELLERNAME").Width = 180
            gridbill.Columns("QUALITY").Width = 100

            gridbill.OptionsPrint.AutoWidth = False
            gridbill.OptionsPrint.PrintHorzLines = True
            gridbill.OptionsPrint.PrintVertLines = True

            Dim ps As New DevExpress.XtraPrinting.PrintingSystem()
            Dim link As New DevExpress.XtraPrinting.PrintableComponentLink(ps)
            link.Component = gridControlObj

            link.Landscape = True
            link.Margins.Left = 30
            link.Margins.Right = 30
            link.Margins.Top = 30
            link.Margins.Bottom = 30
            AddHandler link.CreateDetailArea, Sub(sender As Object, e As DevExpress.XtraPrinting.CreateAreaEventArgs)
                                                  e.Graph.Font = New Font("Verdana", 2)
                                              End Sub

            link.CreateDocument()
            link.ExportToPdf(filePath)

            MessageBox.Show("PDF Exported Successfully: " & filePath)
        Catch ex As Exception
            MessageBox.Show("Export failed: " & ex.Message)
        End Try

    End Sub

    Private Sub cmdcancel_Click(sender As Object, e As EventArgs) Handles cmdcancel.Click
        Me.Close()
    End Sub

